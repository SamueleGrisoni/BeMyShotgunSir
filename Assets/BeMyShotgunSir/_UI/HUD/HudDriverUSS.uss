:root {
}

.power-up-bar-container {
    height: 160px;
    align-self: center;
    margin-top: 50px;
    width: 80%;
}

.power-up-bar {
    flex-grow: 1;
    align-self: stretch;
}

.shout-box {
    width: 400px;
    height: 400px;
    align-self: center;
}

.bottom-bar-container {
    flex-grow: 1;
    position: absolute;
    width: 100%;
    height: 1200px;
    bottom: 0;
}

.bottom-bar {
    bottom: 0%;
    flex-grow: 1;
}

.early-commitment-container {
    flex-grow: 1;
    position: absolute;
    width: 100%;
    bottom: 650px;
}

.early-commitment {
    bottom: 0;
    height: 500px;
}
