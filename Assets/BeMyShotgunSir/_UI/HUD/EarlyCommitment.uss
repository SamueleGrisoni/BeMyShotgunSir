.uiroot {
    width: 100%;
    height: 100%;
}

.content-area {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
}

.earlycommitment-container {
    position: absolute;
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    transition-property: scale, left, bottom, top;
    transition-duration: 0.35s;
    transition-timing-function: ease-out;
}

.earlycommitment {
    width: 50%;
    height: 35%;
    border-radius: 40px;
    border-width: 0;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    color: white;
    -unity-font-definition: url("project://database/Assets/Fonts/Edo_new.ttf?fileID=12800000&guid=7ef7c4949f3504cc4810fcd3922630c5&type=3#Edo_new");
    font-size: 60px;
    margin-bottom: 100px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
}

.commitment-choice {
    width: 100%;
    height: 80%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    pointer-events: none;
}

.choice-arrow {
    width: 20%;
    height: 100%;
    padding: 12px;
    margin-top: 50px;
    margin-bottom: 50px;
    border-radius: 12px;
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.55);
    background-color: rgba(255, 255, 255, 0.1);
    box-shadow: 0 4px 0 rgba(0, 0, 0, 0.3);
    justify-content: center;
    align-items: center;
}

.glass-shine {
    position: absolute;
    top: 0;
    left: 8%;
    width: 84%;
    height: 35%;
    border-bottom-left-radius: 50%;
    border-bottom-right-radius: 50%;
    background-color: rgba(255, 255, 255, 0.18);
}

.commit-label {
    color: white;
    font-size: 380px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Fonts/ZingRust.ttf?fileID=12800000&guid=8fb97d298a61e46ae8116702da0d37bc&type=3#ZingRust");
    -unity-text-outline-width: 20px;
    text-shadow: 10px 10px 0 rgb(255, 254, 0);
    -unity-text-generator: advanced;
    -unity-text-auto-size: none;
    margin-right: 10%;
}

.commit-gauge-bar {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 10px;
}

.boost-label {
    color: white;
    -unity-font-definition: url("project://database/Assets/Fonts/Edo_new.ttf?fileID=12800000&guid=7ef7c4949f3504cc4810fcd3922630c5&type=3#Edo_new");
    font-size: 60px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
}

.commit-label {
    color: white;
    font-size: 380px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/Fonts/ZingRust.ttf?fileID=12800000&guid=8fb97d298a61e46ae8116702da0d37bc&type=3#ZingRust");
    -unity-text-outline-width: 20px;
    text-shadow: 10px 10px 0 rgb(255, 254, 0);
    -unity-text-generator: advanced;
    -unity-text-auto-size: none;
    margin-right: 10%;
}

.mobile-portrait {
    height: 50%;
    min-height: 1080px;
}

.mobile-landscape {
}
