:root {
}

.uiroot {
    position: absolute;
    width: 100%;
    height: 100%;
}

.content-area {
    position: absolute;
    width: 100%;
    height: 100%;
    flex-direction: column;
}

.drift-control {
    width: 100%;
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    height: 200px;
    background-color: rgba(0, 0, 0, 0.004);
}

.steer-control {
    width: 100%;
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.004);

}

.editor-debug {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(255, 0, 0);
    border-right-color: rgb(255, 0, 0);
    border-top-color: rgb(255, 0, 0);
    border-bottom-color: rgb(255, 0, 0);
}

.mobile-portrait {
    min-height: 600px;
}

.steer-joystick {
    height: 80%;
    width: auto;
    aspect-ratio: 1;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/__LocalPackages/Joystick%20Pack/Sprites/All%20Axis%20Backgrounds/AllAxis_Outline.png?fileID=2800000&guid=5b56d9fa0e8bd6e409ed188db38a692c&type=3#AllAxis_Outline");
    -unity-font-definition: url("project://database/Assets/BeMyShotgunSir/Demos/UI/Fonts/Edo_new.ttf?fileID=12800000&guid=7ef7c4949f3504cc4810fcd3922630c5&type=3#Edo_new");
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    -unity-text-auto-size: best-fit 10px 100px;
    -unity-text-generator: advanced;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}

.drift-origin {
    display: none;
    position: absolute;
    background-image: url("project://database/Assets/__LocalPackages/Joystick%20Pack/Sprites/All%20Axis%20Backgrounds/AllAxis_Outline.png?fileID=2800000&guid=5b56d9fa0e8bd6e409ed188db38a692c&type=3#AllAxis_Outline");
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
    height: 60%;
    aspect-ratio: 1;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.24);
}

.drift-joystick {
    display: none;
    position: absolute;
    background-image: url("project://database/Assets/__LocalPackages/Joystick%20Pack/Sprites/All%20Axis%20Backgrounds/AllAxis_Outline.png?fileID=2800000&guid=5b56d9fa0e8bd6e409ed188db38a692c&type=3#AllAxis_Outline");
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
    height: 60%;
    aspect-ratio: 1;
}
