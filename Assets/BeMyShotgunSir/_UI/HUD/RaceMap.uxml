                </ui:VisualElement>
                <ui:VisualElement name="RightColumn" class="power-up-column">
                    <ui:VisualElement name="RightPowerUp1" class="power-up-icon" style="background-image: url(&quot;project://database/Assets/BeMyShotgunSir/Demos/UI/Graphics/PowerUp_RoadBlock.png?fileID=2800000&amp;guid=480c96efec2a4463d849fa83eb0c8bee&amp;type=3#PowerUp_RoadBlock&quot;);"/>
                    <ui:VisualElement name="RightPowerUp2" class="power-up-icon" style="background-image: url(&quot;project://database/Assets/BeMyShotgunSir/Demos/UI/Graphics/PowerUp_Shield.png?fileID=2800000&amp;guid=7ef0aac922f9b4d28aed5c01ad4f163b&amp;type=3#PowerUp_Shield&quot;);"/>
