            <ui:VisualElement name="PowerUpArea" style="height: 350px; position: absolute; width: 90%; align-self: center; flex-direction: row; justify-content: space-between; top: 154px;">
                <ui:VisualElement name="LeftColumn" class="power-up-column">
                    <ui:VisualElement name="LeftPowerUp1" class="power-up-icon" style="background-image: url(&quot;project://database/Assets/BeMyShotgunSir/Demos/UI/Graphics/PowerUp_Armor.png?fileID=2800000&amp;guid=8b0a2e8130b6a4a15bfb4c4e4cb71000&amp;type=3#PowerUp_Armor&quot;);"/>
