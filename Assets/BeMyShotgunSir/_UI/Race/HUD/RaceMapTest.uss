:root {
}

.map-tiles {
    position: absolute;
    align-self: center;
    width: 90%;
    height: 95%;
    overflow: hidden;
}

.map-content {
    position: absolute;
    width: 100%;
    height: 100%;
    flex-direction: column-reverse;
    justify-content: center;
    transform-origin: center center;
}

.row {
    position: relative;
    flex-shrink: 0;
    margin-top: -1px;
}

.rc-icon {
    position: absolute;
    -unity-background-scale-mode: scale-to-fit;
}
