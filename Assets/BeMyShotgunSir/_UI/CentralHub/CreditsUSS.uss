.credits-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.8);
}

.credits-title {
    -unity-font-style: normal;
    font-size: 200px;
    color: white;
    margin-top: auto;
    margin-bottom: auto;
    -unity-text-align: middle-center;
    -unity-font-definition: url("project://database/Assets/BeMyShotgunSir/Demos/UI/Fonts/Edo_new.ttf?fileID=12800000&guid=7ef7c4949f3504cc4810fcd3922630c5&type=3#Edo_new");
}

.credits-panel {
    width: 100%;
    height: 100%;
    background-color: rgba(29, 29, 29, 0.95);
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    padding: 24px;
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    border-top-width: 10px;
    border-right-width: 10px;
    border-bottom-width: 10px;
    border-left-width: 10px;
    border-left-color: rgba(255, 255, 255, 0.31);
    border-right-color: rgba(255, 255, 255, 0.31);
    border-top-color: rgba(255, 255, 255, 0.31);
    border-bottom-color: rgba(255, 255, 255, 0.31);
    border-top-left-radius: 50px;
    border-top-right-radius: 50px;
    border-bottom-right-radius: 50px;
    border-bottom-left-radius: 50px;
    align-items: center;
    justify-content: space-between;
}

.credits-header {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 15px;
    margin-top: 20px;
}

.credits-section-title {
    font-size: 100px;
    color: rgb(255, 255, 0);
    margin-top: 20px;
    -unity-font-definition: url("project://database/Assets/BeMyShotgunSir/Demos/UI/Fonts/Edo_new.ttf?fileID=12800000&guid=7ef7c4949f3504cc4810fcd3922630c5&type=3#Edo_new");
    width: 70%;
    margin-left: auto;
    margin-right: auto;
    -unity-text-align: middle-center;
    white-space: nowrap;
    margin-bottom: 20px;
}

.credits-name {
    font-size: 80px;
    color: white;
    margin-top: 5px;
    margin-bottom: 5px;
    -unity-font-definition: url("project://database/Assets/BeMyShotgunSir/Demos/UI/Fonts/Edo_new.ttf?fileID=12800000&guid=7ef7c4949f3504cc4810fcd3922630c5&type=3#Edo_new");
    width: 70%;
    margin-left: auto;
    margin-right: auto;
    -unity-text-align: middle-center;
}

.credits-disclaimer {
    font-size: 40px;
    color: rgb(255, 255, 0);
    margin-top: 25px;
    margin-bottom: 15px;
    -unity-font-definition: url("project://database/Assets/BeMyShotgunSir/Demos/UI/Fonts/ZingRust.ttf?fileID=12800000&guid=8fb97d298a61e46ae8116702da0d37bc&type=3#ZingRust");
    width: 80%;
    margin-left: auto;
    margin-right: auto;
    -unity-text-align: middle-center;
    white-space: normal;
}

.menu-button {
    width: 80%;
    height: 200px;
    border-radius: 40px;
    border-width: 4px;
    border-color: rgba(255, 255, 255, 0.15);
    justify-content: center;
    align-items: center;
    color: white;
    margin-bottom: 50px;
    -unity-font-definition: url("project://database/Assets/BeMyShotgunSir/Demos/UI/Fonts/Edo_new.ttf?fileID=12800000&guid=7ef7c4949f3504cc4810fcd3922630c5&type=3#Edo_new");
    font-size: 150px;
    margin-top: 50px;
    align-self: center;
}
