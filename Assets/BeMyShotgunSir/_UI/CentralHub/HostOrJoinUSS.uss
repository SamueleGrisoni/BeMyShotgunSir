:root {
}

.lobby-root {
}

.lobby-background {
    width: 100%;
    height: 100%;
    background-color: rgb(0, 0, 0);
    position: absolute;
}

.title-container {
    align-items: center;
    max-width: 80%;
    align-self: center;
}

.title-label {
    white-space: pre-wrap;
    font-size: 200px;
    -unity-font-definition: url("project://database/Assets/BeMyShotgunSir/Demos/UI/Fonts/Edo_new.ttf?fileID=12800000&guid=7ef7c4949f3504cc4810fcd3922630c5&type=3#Edo_new");
    color: rgb(255, 255, 255);
    -unity-text-align: upper-center;
}

.title-label .hosting {
    label: hosting;
}



.host-join-button-container {
    flex-direction: column;
    width: 100%;
    align-items: center;
    display: flex;
    position: relative;
    top: 50%;
}



.menu-button {
    width: 80%;
    height: 200px;
    border-radius: 40px;
    border-width: 4px;
    border-color: rgba(255, 255, 255, 0.15);
    justify-content: center;
    align-items: center;
    color: white;
    margin-bottom: 100px;
    -unity-font-definition: url("project://database/Assets/BeMyShotgunSir/Demos/UI/Fonts/Edo_new.ttf?fileID=12800000&guid=7ef7c4949f3504cc4810fcd3922630c5&type=3#Edo_new");
    font-size: 150px;
    -unity-text-generator: advanced;
    -unity-text-auto-size: best-fit 10px 150px;
}

.menu-field {
    width: 80%;
    height: 100px;
    border-radius: 40px;
    border-width: 4px;
    border-color: rgba(255, 255, 255, 0.15);
    justify-content: center;
    align-items: center;
    color: black;
    margin-bottom: 100px;
    -unity-font-definition: url("project://database/Assets/BeMyShotgunSir/Demos/UI/Fonts/Edo_new.ttf?fileID=12800000&guid=7ef7c4949f3504cc4810fcd3922630c5&type=3#Edo_new");
    font-size: 100px;
    -unity-text-align: middle-center;
}

.back-button {
    align-self: center;
    position: absolute;
    bottom: 0;
}
