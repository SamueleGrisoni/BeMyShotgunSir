.title-container {
    align-items: center;
}

.button-container {
    flex-direction: column;
    margin-top: 50px;
    position: absolute;
    align-self: center;
    top: 50%;
    width: 100%;
    align-items: center;
}

.menu-button {
    width: 80%;
    height: 200px;
    border-radius: 40px;
    border-width: 4px;
    border-color: rgba(255, 255, 255, 0.15);
    justify-content: center;
    align-items: center;
    color: white;
    margin-bottom: 100px;
    -unity-font-definition: url("project://database/Assets/Fonts/Edo_new.ttf?fileID=12800000&guid=7ef7c4949f3504cc4810fcd3922630c5&type=3#Edo_new");
    font-size: 150px;
}
