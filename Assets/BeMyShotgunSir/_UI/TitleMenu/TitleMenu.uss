}

.title-root {
}

.title-background {
    width: 100%;
    height: 100%;
    /* background-image: resource("UI/TitleBackground");
    background-image-color: rgb(255, 255, 255);
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(255, 255, 255); */
    background-color: rgb(0, 0, 0);
    position: absolute;
